    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.1.1",
    "msw": "^2.12.14",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.0",
    "typescript-language-server": "6.0.1",
    "vite": "^6.4.6",
    "vite-plugin-babel": "^1.3.0",
    "vitest": "^4.1.12"
