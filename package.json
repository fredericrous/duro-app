    "@aval-adr/eslint-config": "^0.16.0",
    "@babel/preset-typescript": "^7.28.5",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "0.87.5",
    "@effect/vitest": "^0.30.1",
    "@eslint/js": "^10.0.1",
    "@greenharness/greengate": "^4.11.0",
    "@greenharness/greenrack-eslint-config": "7.2.1",
    "@greenharness/greenrack-eslint-plugin": "7.2.1",
