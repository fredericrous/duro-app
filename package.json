    "@peculiar/x509": "3.1.0",
    "@react-email/components": "^1.0.9",
    "@react-email/render": "^2.0.4",
    "@react-router/node": "^7.18.5",
    "@react-router/serve": "^7.18.5",
    "@serenity-kit/opaque": "^1.1.0",
    "@tanstack/react-table": "^8.21.3",
    "accept-language-parser": "^1.5.0",
    "effect": "3.22.5",
    "i18next": "^26.3.4",
    "isbot": "^5.1.0",
    "jose": "^6.0.0",
    "match-sorter": "^8.3.0",
    "node-forge": "^1.4.3",
    "nodemailer": "^10.5.0",
    "openid-client": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
